.root {
    padding: 10px;
}

.title {
    font-size: 16px;
    unity-font-style: bold;
    margin-bottom: 8px;
}

.status {
    margin-top: 6px;
    color: #bbbbbb;
}

.tree-container {
    flex-direction: column;
    gap: 8px;
}

